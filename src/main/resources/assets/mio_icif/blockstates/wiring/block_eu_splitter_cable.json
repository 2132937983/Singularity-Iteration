      "apply": { "model": "mio_icif:block/wiring/cable/block_eu_splitter_cable_side", "y": 90, "uvlock": true }
    },
    {
      "when": { "active": "false", "west": "true" },
      "apply": { "model": "mio_icif:block/wiring/cable/block_eu_splitter_cable_side", "y": 270, "uvlock": true }
    },
    {
      "when": { "active": "false", "up": "true" },
      "apply": { "model": "mio_icif:block/wiring/cable/block_eu_splitter_cable_side", "x": 270, "uvlock": true }
    },
    {
