      "apply": { "model": "mio_icif:block/wiring/cable/block_eu_splitter_cable_on" }
    },
    {
      "when": { "active": "false", "north": "true" },
      "apply": { "model": "mio_icif:block/wiring/cable/block_eu_splitter_cable_side", "uvlock": true }
    },
    {
      "when": { "active": "false", "south": "true" },
      "apply": { "model": "mio_icif:block/wiring/cable/block_eu_splitter_cable_side", "y": 180, "uvlock": true }
    },
    {
