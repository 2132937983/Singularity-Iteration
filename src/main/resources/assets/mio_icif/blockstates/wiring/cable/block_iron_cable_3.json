{
  "multipart": [
    {
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3"
      }
    },
    {
      "when": {
        "casing": "construction_wall"
      },
      "apply": {
        "model": "mio_icif:block/build/block_construction_wall"
      }
    },
    {
      "when": {
        "casing": "cf_wall"
      },
      "apply": {
        "model": "mio_icif:block/build/block_cf_wall"
      }
    },
    {
      "when": {
        "casing": "scaffold"
      },
      "apply": {
        "model": "mio_icif:block/build/block_scaffold_iron"
      }
    },
    {
      "when": {
        "casing": "foam"
      },
      "apply": {
        "model": "mio_icif:block/build/block_construction_foam"
      }
    },
    {
      "when": {
        "casing": "reinforced_foam"
      },
      "apply": {
        "model": "mio_icif:block/build/block_construction_foam_reinforced"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3_side",
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3_side",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3_side",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3_side",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3_side",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_iron_cable_3_side",
        "x": 90,
        "uvlock": true
      }
    }
