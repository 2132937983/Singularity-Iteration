{
  "multipart": [
    {
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable"
      }
    },
    {
      "when": { "foamlogged": "true", "foam_reinforced": "false", "disguised": "false" },
      "apply": { "model": "mio_icif:block/build/block_construction_foam" }
    },
    {
      "when": { "foamlogged": "true", "foam_reinforced": "true", "disguised": "false" },
      "apply": { "model": "mio_icif:block/build/block_construction_foam_reinforced" }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable_side",
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable_side",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable_side",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable_side",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable_side",
        "x": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "mio_icif:block/wiring/cable/block_tin_cable_side",
        "x": 90,
        "uvlock": true
      }
    }
  ]
}